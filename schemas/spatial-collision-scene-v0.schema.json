{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/spatial-collision-scene-v0.schema.json",
  "title": "UniLab candidate collision scene v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sample_id",
    "mode",
    "qualification",
    "world_frame",
    "source_digests",
    "entities",
    "allowed_overlaps",
    "limitations",
    "scene_digest"
  ],
  "properties": {
    "schema": {"const": "lab.spatial-collision-scene/v0"},
    "sample_id": {"type": "string", "minLength": 1},
    "mode": {"const": "shadow"},
    "qualification": {"enum": ["simulation-proxy-only", "collision-qualified"]},
    "world_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "units", "up_axis", "handedness"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "units": {"const": "m"},
        "up_axis": {"enum": ["+Z", "+Y"]},
        "handedness": {"const": "right-handed"}
      }
    },
    "source_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "allowed_overlaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/allowedOverlap"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scene_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "aabb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_m", "max_m"],
      "properties": {
        "min_m": {"$ref": "#/$defs/vec3"},
        "max_m": {"$ref": "#/$defs/vec3"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "role",
        "dynamic",
        "geometry_path",
        "geometry_sha256",
        "geometry_format",
        "geometry_unit",
        "collision_mode",
        "component_count",
        "component_world_aabbs",
        "pose_world",
        "local_aabb",
        "world_aabb",
        "uncertainty_m_xyz",
        "qualification"
      ],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["static-environment", "stored-tool", "dynamic-link", "payload"]},
        "dynamic": {"type": "boolean"},
        "geometry_path": {"type": "string", "minLength": 1},
        "geometry_sha256": {"$ref": "#/$defs/digest"},
        "geometry_format": {"enum": ["glb", "stl"]},
        "geometry_unit": {"enum": ["m", "mm"]},
        "collision_mode": {"type": "string", "minLength": 1},
        "component_count": {"type": "integer", "minimum": 1},
        "component_triangle_counts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 4}
        },
        "component_world_aabbs": {
          "type": "array",
          "items": {"$ref": "#/$defs/aabb"}
        },
        "pose_world": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xyz_m", "rpy_deg"],
          "properties": {
            "xyz_m": {"$ref": "#/$defs/vec3"},
            "rpy_deg": {"$ref": "#/$defs/vec3"}
          }
        },
        "local_aabb": {"$ref": "#/$defs/aabb"},
        "world_aabb": {"$ref": "#/$defs/aabb"},
        "uncertainty_m_xyz": {"$ref": "#/$defs/vec3"},
        "qualification": {"enum": ["simulation-proxy-only", "collision-qualified"]}
      }
    },
    "allowedOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_ids", "reason", "approval"],
      "properties": {
        "entity_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1},
        "approval": {"const": "source-layout-candidate"}
      }
    }
  }
}
