{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/spatial-playback-trajectory-v0.schema.json",
  "title": "UniLab diagnostic spatial playback trajectory v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sample_id", "action_contract_id", "mode", "effect",
    "qualification", "world_frame", "source_digests", "timing", "coverage",
    "attachment_models", "segments", "limitations", "playback_digest"
  ],
  "properties": {
    "schema": {"const": "lab.spatial-playback-trajectory/v0"},
    "sample_id": {"type": "string", "minLength": 1},
    "action_contract_id": {"type": "string", "minLength": 1},
    "mode": {"const": "shadow"},
    "effect": {"const": "none"},
    "qualification": {"const": "diagnostic-playback"},
    "world_frame": {"$ref": "#/$defs/worldFrame"},
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_contract", "link_state_sequence", "compiled_clip", "proxy_asset_manifest", "device_manifest"],
      "properties": {
        "motion_contract": {"$ref": "#/$defs/digest"},
        "link_state_sequence": {"$ref": "#/$defs/digest"},
        "compiled_clip": {"$ref": "#/$defs/digest"},
        "proxy_asset_manifest": {"$ref": "#/$defs/digest"},
        "device_manifest": {"$ref": "#/$defs/digest"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_s", "nominal_frame_rate_hz", "clock"],
      "properties": {
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "nominal_frame_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "clock": {"const": "offline-compiled-relative-time"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_motion_segments", "playable_segments", "compiled_move_l_segments",
        "nominal_move_j_segments", "cp_unresolved_playable_segments",
        "total_frame_count", "compiled_move_l_frame_count", "payload_attached_frame_count"
      ],
      "properties": {
        "total_motion_segments": {"type": "integer", "minimum": 1},
        "playable_segments": {"type": "integer", "minimum": 1},
        "compiled_move_l_segments": {"type": "integer", "minimum": 0},
        "nominal_move_j_segments": {"type": "integer", "minimum": 0},
        "cp_unresolved_playable_segments": {"type": "integer", "minimum": 0},
        "total_frame_count": {"type": "integer", "minimum": 2},
        "compiled_move_l_frame_count": {"type": "integer", "minimum": 0},
        "payload_attached_frame_count": {"type": "integer", "minimum": 0}
      }
    },
    "attachment_models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/attachmentModel"}
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/segment"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "playback_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "vec6": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"type": "number"}
    },
    "matrix4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "array", "minItems": 4, "maxItems": 4,
        "items": {"type": "number"}
      }
    },
    "aabb": {
      "type": "object", "additionalProperties": false,
      "required": ["min_m", "max_m"],
      "properties": {
        "min_m": {"$ref": "#/$defs/vec3"},
        "max_m": {"$ref": "#/$defs/vec3"}
      }
    },
    "worldFrame": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "units", "up_axis", "handedness"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "units": {"const": "m"},
        "up_axis": {"const": "+Z"},
        "handedness": {"const": "right-handed"}
      }
    },
    "attachmentModel": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_id", "kind", "geometry_source", "dimensions_m", "placement_source"],
      "properties": {
        "attachment_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["tool", "payload"]},
        "geometry_source": {"type": "string", "minLength": 1},
        "dimensions_m": {"$ref": "#/$defs/vec3"},
        "placement_source": {"type": "string", "minLength": 1}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["link_id", "matrix_link_to_world", "world_aabb"],
      "properties": {
        "link_id": {"type": "string", "minLength": 1},
        "matrix_link_to_world": {"$ref": "#/$defs/matrix4"},
        "world_aabb": {"$ref": "#/$defs/aabb"}
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_id", "kind", "geometry_source", "matrix_attachment_to_world", "world_aabb"],
      "properties": {
        "attachment_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["tool", "payload"]},
        "geometry_source": {"type": "string", "minLength": 1},
        "matrix_attachment_to_world": {"$ref": "#/$defs/matrix4"},
        "world_aabb": {"$ref": "#/$defs/aabb"}
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": [
        "frame_index", "time_s", "segment_time_s", "progress",
        "controller_joint_deg", "links", "attachments"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "time_s": {"type": "number", "minimum": 0},
        "segment_time_s": {"type": "number", "minimum": 0},
        "progress": {"type": "number", "minimum": 0, "maximum": 1},
        "controller_joint_deg": {"$ref": "#/$defs/vec6"},
        "links": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {"$ref": "#/$defs/link"}
        },
        "attachments": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": {"$ref": "#/$defs/attachment"}
        }
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "segment_index", "source_state_id", "target_state_id", "target_step_index",
        "source_clip_step_index", "point_ref", "motion", "cp", "phase",
        "payload_state", "duration_s", "start_time_s", "end_time_s",
        "timing_source", "interpolation", "controller_fidelity", "reason_codes", "frames"
      ],
      "properties": {
        "segment_index": {"type": "integer", "minimum": 0},
        "source_state_id": {"type": "string", "minLength": 1},
        "target_state_id": {"type": "string", "minLength": 1},
        "target_step_index": {"type": "integer", "minimum": 0},
        "source_clip_step_index": {"type": "integer", "minimum": 0},
        "point_ref": {"type": "string", "minLength": 1},
        "motion": {"enum": ["move_j", "move_l"]},
        "cp": {"type": "number"},
        "phase": {"enum": ["approach", "transfer", "retreat"]},
        "payload_state": {"type": "string", "minLength": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "start_time_s": {"type": "number", "minimum": 0},
        "end_time_s": {"type": "number", "exclusiveMinimum": 0},
        "timing_source": {"const": "compiled-clip-duration"},
        "interpolation": {"enum": ["compiled-move-l-joint-trajectory", "nominal-move-j", "nominal-unblended-move-j"]},
        "controller_fidelity": {"enum": ["diagnostic-compiled-move-l", "nominal-controller-unverified"]},
        "reason_codes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "frames": {
          "type": "array", "minItems": 2,
          "items": {"$ref": "#/$defs/frame"}
        }
      }
    }
  }
}
