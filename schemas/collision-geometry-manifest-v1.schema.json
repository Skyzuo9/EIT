{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/collision-geometry-manifest-v1.schema.json",
  "title": "UniLab spatial-ready collision geometry manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "sample_id",
    "qualification",
    "allowed_uses",
    "frame",
    "source_artifacts",
    "generator",
    "assets",
    "capabilities",
    "limitations",
    "manifest_digest"
  ],
  "properties": {
    "schema": {"const": "lab.collision-geometry-manifest/v1"},
    "manifest_id": {"type": "string", "pattern": "^collision-geometry-manifest:[a-z0-9][a-z0-9._/-]*/v1$"},
    "sample_id": {"type": "string", "minLength": 1},
    "qualification": {"enum": ["collision-candidate", "collision-qualified"]},
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["offline-review", "shadow", "software-admission"]}
    },
    "frame": {"$ref": "#/$defs/frame"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "version", "implementation_path", "implementation_digest_mode", "implementation_sha256"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_path": {"$ref": "#/$defs/relativePath"},
        "implementation_digest_mode": {"$ref": "#/$defs/digestMode"},
        "implementation_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render", "broad_phase", "narrow_phase", "dynamic_links", "collision_qualified"],
      "properties": {
        "render": {"type": "boolean"},
        "broad_phase": {"type": "boolean"},
        "narrow_phase": {"type": "boolean"},
        "dynamic_links": {"type": "boolean"},
        "collision_qualified": {"type": "boolean"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"qualification": {"const": "collision-candidate"}}},
      "then": {
        "properties": {
          "allowed_uses": {
            "items": {"enum": ["offline-review", "shadow"]}
          },
          "capabilities": {
            "properties": {"collision_qualified": {"const": false}}
          }
        }
      }
    },
    {
      "if": {"properties": {"qualification": {"const": "collision-qualified"}}},
      "then": {
        "properties": {
          "capabilities": {
            "properties": {"collision_qualified": {"const": true}}
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digestMode": {"enum": ["raw-bytes", "canonical-json-v1", "utf8-lf-v1"]},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "nonNegativeVec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number", "minimum": 0}
    },
    "aabb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_m", "max_m"],
      "properties": {
        "min_m": {"$ref": "#/$defs/vec3"},
        "max_m": {"$ref": "#/$defs/vec3"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "unit", "up_axis", "handedness", "origin_convention"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "unit": {"const": "m"},
        "up_axis": {"enum": ["+Z", "+Y"]},
        "handedness": {"const": "right-handed"},
        "origin_convention": {"type": "string", "minLength": 1}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "digest_mode", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "digest_mode": {"$ref": "#/$defs/digestMode"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifactGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format", "source_unit", "local_aabb_m"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "format": {"enum": ["glb", "stl"]},
        "source_unit": {"enum": ["m", "mm"]},
        "local_aabb_m": {"$ref": "#/$defs/aabb"}
      }
    },
    "narrowPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "format",
        "source_unit",
        "local_aabb_m",
        "representation",
        "component_count",
        "watertight"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "format": {"enum": ["glb", "stl"]},
        "source_unit": {"enum": ["m", "mm"]},
        "local_aabb_m": {"$ref": "#/$defs/aabb"},
        "representation": {"enum": ["solid-aabb", "multi-body-open", "multi-body-shaped", "compound-convex", "simplified-static-mesh"]},
        "component_count": {"type": "integer", "minimum": 1},
        "component_triangle_counts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 4}
        },
        "watertight": {"type": "boolean"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "entity_id",
        "role",
        "source",
        "frame",
        "nominal_dimensions_m",
        "visual",
        "broad_phase",
        "narrow_phase",
        "derivation",
        "uncertainty_m_xyz",
        "qc",
        "qualification",
        "reason_codes"
      ],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "entity_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["static-environment", "stored-tool", "dynamic-link", "tool", "payload"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifact_ref", "artifact_digest_mode", "artifact_sha256", "parameter_pointer", "parameter_digest"],
          "properties": {
            "kind": {"enum": ["parametric-spec", "step-brep", "solidworks", "urdf", "glb-tessellation", "stl-reference"]},
            "artifact_ref": {"$ref": "#/$defs/relativePath"},
            "artifact_digest_mode": {"$ref": "#/$defs/digestMode"},
            "artifact_sha256": {"$ref": "#/$defs/digest"},
            "parameter_pointer": {"type": "string", "pattern": "^/"},
            "parameter_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "frame": {"$ref": "#/$defs/frame"},
        "nominal_dimensions_m": {"$ref": "#/$defs/nonNegativeVec3"},
        "visual": {"$ref": "#/$defs/artifactGeometry"},
        "broad_phase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "local_aabb_m"],
          "properties": {
            "kind": {"const": "aabb"},
            "local_aabb_m": {"$ref": "#/$defs/aabb"}
          }
        },
        "narrow_phase": {"$ref": "#/$defs/narrowPhase"},
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "algorithm_version", "generator_ref", "generator_digest_mode", "generator_sha256"],
          "properties": {
            "algorithm": {"type": "string", "minLength": 1},
            "algorithm_version": {"type": "string", "minLength": 1},
            "generator_ref": {"$ref": "#/$defs/relativePath"},
            "generator_digest_mode": {"$ref": "#/$defs/digestMode"},
            "generator_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "uncertainty_m_xyz": {"$ref": "#/$defs/nonNegativeVec3"},
        "qc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds_abs_error_m_xyz",
            "bounds_match_nominal",
            "open_cavity_expected",
            "open_cavity_preserved",
            "source_components_disjoint",
            "summed_component_volume_ratio",
            "method"
          ],
          "properties": {
            "bounds_abs_error_m_xyz": {"$ref": "#/$defs/nonNegativeVec3"},
            "bounds_match_nominal": {"type": "boolean"},
            "open_cavity_expected": {"type": "boolean"},
            "open_cavity_preserved": {"type": ["boolean", "null"]},
            "source_components_disjoint": {"type": "boolean"},
            "summed_component_volume_ratio": {"type": "number", "minimum": 0},
            "method": {"type": "string", "minLength": 1}
          }
        },
        "qualification": {"enum": ["collision-candidate", "collision-qualified"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
        }
      }
    }
  }
}
