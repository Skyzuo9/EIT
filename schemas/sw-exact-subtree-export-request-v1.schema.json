{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/sw-exact-subtree-export-request-v1.schema.json",
  "title": "Read-only SolidWorks exact subtree export dry-run request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "mode", "station", "source_read_only",
    "approval_binding", "solidworks", "exporter", "devices"
  ],
  "properties": {
    "schema": {"const": "lab.sw_exact_subtree_export_request/v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-w2-dry-run$"},
    "mode": {"const": "dry-run"},
    "station": {"type": "string", "minLength": 1},
    "source_read_only": {"const": true},
    "approval_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_handoff_sha256", "source_decomposition_sha256",
        "station_layout_sha256", "source_files_digest"
      ],
      "properties": {
        "source_handoff_sha256": {"$ref": "#/$defs/digest"},
        "source_decomposition_sha256": {"$ref": "#/$defs/digest"},
        "station_layout_sha256": {"$ref": "#/$defs/digest"},
        "source_files_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "solidworks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "configuration"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1}
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "selection_mode"],
      "properties": {
        "name": {"const": "SwExactSubtreeExporter"},
        "version": {"type": "string", "minLength": 1},
        "selection_mode": {"const": "approved-exact-occurrence-root"}
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_instance", "slice_role", "family", "exact_subtree_root"],
        "properties": {
          "asset_instance": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "slice_role": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "exact_subtree_root": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
