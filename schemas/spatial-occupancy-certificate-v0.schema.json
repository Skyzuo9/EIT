{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/spatial-occupancy-certificate-v0.schema.json",
  "title": "UniLab spatial occupancy certificate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "certificate_id",
    "sample_id",
    "action_contract_id",
    "mode",
    "qualification",
    "input_digests",
    "analysis",
    "certificate_digest"
  ],
  "properties": {
    "schema": {"const": "lab.spatial-occupancy-certificate/v0"},
    "certificate_id": {"type": "string", "pattern": "^spatial-cert:[0-9a-f]{64}$"},
    "sample_id": {"type": "string", "minLength": 1},
    "action_contract_id": {"type": "string", "minLength": 1},
    "mode": {"const": "shadow"},
    "qualification": {
      "const": "candidate",
      "$comment": "v0 binds only test-lock, collision-scene, and motion-contract digests; it cannot express collision-qualified or hardware-qualified evidence."
    },
    "input_digests": {
      "type": "object",
      "required": ["test_lock", "collision_scene", "motion_contract"],
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_corridor_status",
        "continuous_collision_status",
        "stop_envelope_status",
        "recovery_envelope_status",
        "result",
        "reason_codes"
      ],
      "properties": {
        "motion_corridor_status": {"enum": ["not-computed", "candidate", "qualified"]},
        "continuous_collision_status": {"enum": ["not-computed", "candidate", "qualified"]},
        "stop_envelope_status": {"enum": ["unknown", "candidate", "qualified"]},
        "recovery_envelope_status": {"enum": ["unknown", "candidate", "qualified"]},
        "result": {"enum": ["allowed", "blocked", "unknown"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "certificate_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
