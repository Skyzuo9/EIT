{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/spatial-interlock-decision-v0.schema.json",
  "title": "UniLab spatial interlock decision v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "mode",
    "effect",
    "sample_id",
    "action_contract_id",
    "certificate_ref",
    "world_snapshot_version",
    "decision",
    "reason_codes",
    "decision_digest"
  ],
  "properties": {
    "schema": {"const": "lab.spatial-interlock-decision/v0"},
    "decision_id": {"type": "string", "pattern": "^spatial-decision:[0-9a-f]{64}$"},
    "mode": {"const": "shadow"},
    "effect": {"const": "none"},
    "sample_id": {"type": "string", "minLength": 1},
    "action_contract_id": {"type": "string", "minLength": 1},
    "certificate_ref": {"type": "string", "pattern": "^spatial-cert:[0-9a-f]{64}$"},
    "world_snapshot_version": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allowed", "blocked", "unknown"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
