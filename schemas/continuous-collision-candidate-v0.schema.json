{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.local/schemas/continuous-collision-candidate-v0.schema.json",
  "title": "UniLab conservative continuous collision candidate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sample_id",
    "action_contract_id",
    "mode",
    "qualification",
    "world_frame",
    "source_digests",
    "method",
    "coverage",
    "segments",
    "partial_world_aabb",
    "analysis",
    "limitations",
    "candidate_digest"
  ],
  "properties": {
    "schema": {"const": "lab.continuous-collision-candidate/v0"},
    "sample_id": {"type": "string", "minLength": 1},
    "action_contract_id": {"type": "string", "minLength": 1},
    "mode": {"const": "shadow"},
    "qualification": {"const": "candidate-partial"},
    "world_frame": {"$ref": "#/$defs/worldFrame"},
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_contract", "link_state_sequence", "motion_corridor"],
      "properties": {
        "motion_contract": {"$ref": "#/$defs/digest"},
        "link_state_sequence": {"$ref": "#/$defs/digest"},
        "motion_corridor": {"$ref": "#/$defs/digest"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpolation_assumption",
        "bound",
        "eligible_segment_rule",
        "self_collision_pair_rule"
      ],
      "properties": {
        "interpolation_assumption": {"const": "linear-controller-joint-space"},
        "bound": {"const": "per-subinterval-link-aabb-expanded-by-summed-joint-arc-length"},
        "eligible_segment_rule": {"const": "move_j-and-cp-equals-zero"},
        "self_collision_pair_rule": {"const": "exclude-identical-and-adjacent-links"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_motion_segments",
        "continuous_evaluated_move_j_segments",
        "excluded_move_j_cp_segments",
        "excluded_move_l_segments"
      ],
      "properties": {
        "total_motion_segments": {"type": "integer", "minimum": 1},
        "continuous_evaluated_move_j_segments": {"type": "integer", "minimum": 1},
        "excluded_move_j_cp_segments": {"type": "integer", "minimum": 0},
        "excluded_move_l_segments": {"type": "integer", "minimum": 0}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/segment"}
    },
    "partial_world_aabb": {"$ref": "#/$defs/aabb"},
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuous_link_bound_status",
        "self_collision_status",
        "environment_collision_status",
        "overall_result"
      ],
      "properties": {
        "continuous_link_bound_status": {"const": "computed-conservative-partial"},
        "self_collision_status": {"enum": ["candidate-overlap", "broad-phase-separated"]},
        "environment_collision_status": {"const": "not-evaluated-frame-unregistered"},
        "overall_result": {"const": "unknown"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "aabb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_m", "max_m"],
      "properties": {
        "min_m": {"$ref": "#/$defs/vec3"},
        "max_m": {"$ref": "#/$defs/vec3"}
      }
    },
    "worldFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "units", "up_axis", "handedness"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "units": {"const": "m"},
        "up_axis": {"const": "+Z"},
        "handedness": {"const": "right-handed"}
      }
    },
    "linkEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "conservative_aabb_union",
        "max_subinterval_displacement_bound_m"
      ],
      "properties": {
        "link_id": {"type": "string", "minLength": 1},
        "conservative_aabb_union": {"$ref": "#/$defs/aabb"},
        "max_subinterval_displacement_bound_m": {"type": "number", "minimum": 0}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_a", "link_b", "result", "candidate_interval_indices"],
      "properties": {
        "link_a": {"type": "string", "minLength": 1},
        "link_b": {"type": "string", "minLength": 1},
        "result": {"enum": ["candidate-overlap", "separated-by-conservative-aabb"]},
        "candidate_interval_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "candidate-overlap"}}},
          "then": {"properties": {"candidate_interval_indices": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"result": {"const": "separated-by-conservative-aabb"}}},
          "then": {"properties": {"candidate_interval_indices": {"maxItems": 0}}}
        }
      ]
    },
    "selfCollision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_pair_count",
        "separated_pair_count",
        "candidate_overlap_pair_count",
        "pairs"
      ],
      "properties": {
        "evaluated_pair_count": {"type": "integer", "minimum": 1},
        "separated_pair_count": {"type": "integer", "minimum": 0},
        "candidate_overlap_pair_count": {"type": "integer", "minimum": 0},
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pair"}
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_index",
        "source_state_id",
        "target_state_id",
        "target_step_index",
        "phase",
        "payload_state",
        "motion",
        "cp",
        "status",
        "reason_codes"
      ],
      "properties": {
        "segment_index": {"type": "integer", "minimum": 0},
        "source_state_id": {"type": "string", "minLength": 1},
        "target_state_id": {"type": "string", "minLength": 1},
        "target_step_index": {"type": "integer", "minimum": 0},
        "phase": {"enum": ["approach", "transfer", "retreat"]},
        "payload_state": {"type": "string", "minLength": 1},
        "motion": {"enum": ["move_j", "move_l"]},
        "cp": {"type": "number"},
        "status": {"enum": ["continuous-broad-phase-candidate", "excluded-unresolved"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "interval_count": {"type": "integer", "minimum": 1},
        "link_envelopes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/linkEnvelope"}
        },
        "self_collision": {"$ref": "#/$defs/selfCollision"},
        "segment_world_aabb": {"$ref": "#/$defs/aabb"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "continuous-broad-phase-candidate"}}},
          "then": {
            "required": [
              "interval_count",
              "link_envelopes",
              "self_collision",
              "segment_world_aabb"
            ]
          }
        }
      ]
    }
  }
}
